;;; desktop-theme.el --- Desktop palette -*- lexical-binding: t; -*-

(require 'cl-lib)

(deftheme desktop "Colors supplied by the desktop configuration.")

(let ((palette '(@palette@)))
  (apply #'custom-theme-set-faces
         'desktop
         (mapcar
          (lambda (face)
            (list (car face)
                  (list (list t
                              (cl-loop for (key value) on (cdr face) by #'cddr
                                       append (list key (or (alist-get value palette) value)))))))
          '((default :background base :foreground text)
            (cursor :background rosewater)
            (fringe :background base :foreground overlay0)
            (region :background surface1)
            (highlight :background surface0)
            (hl-line :background mantle)
            (shadow :foreground overlay0)
            (minibuffer-prompt :foreground blue :weight bold)
            (link :foreground blue :underline t)
            (link-visited :foreground mauve :underline t)
            (button :foreground lavender :weight bold)
            (success :foreground green)
            (warning :foreground yellow)
            (error :foreground red)
            (match :background surface1 :foreground peach :weight bold)
            (isearch :background yellow :foreground base)
            (lazy-highlight :background surface2 :foreground text)
            (isearch-fail :background red :foreground base)
            (trailing-whitespace :background red)
            (escape-glyph :foreground peach)
            (homoglyph :foreground peach)
            (fill-column-indicator :foreground surface0)
            (line-number :foreground subtext0 :background base)
            (line-number-current-line :foreground peach :background base :weight bold)
            (vertical-border :foreground surface0)
            (window-divider :foreground surface0)
            (window-divider-first-pixel :foreground surface0)
            (window-divider-last-pixel :foreground surface0)
            (mode-line :background surface0 :foreground text)
            (mode-line-inactive :background mantle :foreground overlay1)
            (mode-line-buffer-id :foreground lavender :weight bold)
            (header-line :background mantle :foreground subtext1)
            (tab-bar :background crust :foreground subtext0)
            (tab-bar-tab :background base :foreground text :weight bold)
            (tab-bar-tab-inactive :background mantle :foreground overlay1)
            (font-lock-builtin-face :foreground red)
            (font-lock-comment-face :foreground overlay0 :slant italic)
            (font-lock-comment-delimiter-face :inherit font-lock-comment-face)
            (font-lock-constant-face :foreground peach)
            (font-lock-doc-face :foreground subtext0)
            (font-lock-function-name-face :foreground blue)
            (font-lock-function-call-face :foreground blue)
            (font-lock-keyword-face :foreground mauve)
            (font-lock-negation-char-face :foreground red)
            (font-lock-number-face :foreground peach)
            (font-lock-operator-face :foreground sky)
            (font-lock-preprocessor-face :foreground pink)
            (font-lock-property-name-face :foreground lavender)
            (font-lock-property-use-face :foreground lavender)
            (font-lock-punctuation-face :foreground overlay2)
            (font-lock-regexp-grouping-backslash :foreground pink)
            (font-lock-regexp-grouping-construct :foreground pink)
            (font-lock-string-face :foreground green)
            (font-lock-type-face :foreground yellow)
            (font-lock-variable-name-face :foreground text)
            (font-lock-variable-use-face :foreground text)
            (font-lock-warning-face :foreground red :weight bold)
            (haskell-constructor-face :foreground peach :weight bold)
            (haskell-literate-comment-face :inherit font-lock-comment-face)
            (haskell-operator-face :inherit font-lock-operator-face)
            (show-paren-match :background surface1 :foreground peach :weight bold)
            (show-paren-mismatch :background red :foreground base)
            (completions-common-part :foreground blue :weight bold)
            (completions-first-difference :foreground peach)
            (vertico-current :background surface0 :foreground text)
            (corfu-default :background mantle :foreground text)
            (corfu-current :background surface1 :foreground text)
            (corfu-border :background surface2)
            (orderless-match-face-0 :foreground blue :weight bold)
            (orderless-match-face-1 :foreground mauve :weight bold)
            (orderless-match-face-2 :foreground green :weight bold)
            (orderless-match-face-3 :foreground peach :weight bold)
            (flymake-error :underline (:style wave :color "@errorColor@"))
            (flymake-warning :underline (:style wave :color "@warningColor@"))
            (flymake-note :underline (:style wave :color "@noteColor@"))
            (diff-added :background mantle :foreground green)
            (diff-removed :background mantle :foreground red)
            (diff-changed :foreground yellow)
            (diff-context :foreground subtext0)
            (diff-header :background surface0 :foreground blue)
            (diff-file-header :foreground lavender :weight bold)
            (diff-hunk-header :background surface1 :foreground mauve)
            (magit-section-heading :foreground blue :weight bold)
            (magit-section-highlight :background mantle)
            (magit-branch-local :foreground mauve)
            (magit-branch-remote :foreground green)
            (magit-diff-added :inherit diff-added)
            (magit-diff-added-highlight :background surface0 :foreground green)
            (magit-diff-removed :inherit diff-removed)
            (magit-diff-removed-highlight :background surface0 :foreground red)
            (magit-diff-context-highlight :background mantle :foreground text)
            (magit-diff-hunk-heading :inherit diff-hunk-header)
            (magit-diff-hunk-heading-highlight :background surface2 :foreground text)
            (org-level-1 :foreground blue :weight bold)
            (org-level-2 :foreground mauve :weight bold)
            (org-level-3 :foreground green :weight bold)
            (org-level-4 :foreground yellow :weight bold)
            (org-level-5 :foreground peach)
            (org-level-6 :foreground teal)
            (org-level-7 :foreground pink)
            (org-level-8 :foreground lavender)
            (org-block :background mantle :foreground text)
            (org-block-begin-line :background mantle :foreground overlay0)
            (org-block-end-line :inherit org-block-begin-line)
            (org-code :foreground peach)
            (org-verbatim :foreground green)
            (org-table :foreground teal)
            (org-todo :foreground red :weight bold)
            (org-done :foreground green :weight bold)
            (org-date :foreground blue :underline t)
            (org-link :inherit link)
            (org-document-title :foreground lavender :weight bold)))))

(custom-theme-set-variables 'desktop '(frame-background-mode '@backgroundMode@))

(provide-theme 'desktop)
