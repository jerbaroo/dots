+// Local, versioned bridge: the caller supplies the overview's physical window box.
+APICALL EXPORT void hyprglass_render_overview_v1(Render::CRenderContext& ctx, PHLMONITOR monitor, PHLWINDOW window,
+                                                const CBox& box, float alpha, float scale) {
+    if (!s_instanceActive || !g_pGlobalState || !window)
+        return;
+
+    for (const auto& decoration : window->presentation().decorations()) {
+        if (auto* glass = dynamic_cast<CGlassDecoration*>(decoration.get())) {
+            glass->renderOverview(ctx, monitor, box, alpha, scale);
+            return;
+        }
+    }
 }

